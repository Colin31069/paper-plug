{
  "manifest_version": 3,
  "name": "PaperPlug - Free Academic Paper Search for ChatGPT & Gemini",
  "version": "1.0.0",
  "description": "Find and inject high-quality academic papers from OpenAlex, Semantic Scholar, and arXiv into ChatGPT and Gemini.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openalex.org/*",
    "https://api.semanticscholar.org/*",
    "https://export.arxiv.org/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open PaperPlug"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
